        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ara sıra dokunun. Uygulaması olan kurtarıcılar uyanık olduğunuzu görebilir."
          }
        }
      }
    },
    "beacon.here.last": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "last touch: %@"
          }
        },
