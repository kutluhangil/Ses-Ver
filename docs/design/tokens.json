{
  "$schema-note": "Ses Ver tasarım token'ları v0. Kaynak: docs/design/ses-ver-ios-ekranlari.pdf s.1 + DESIGN_PROMPT.md. F1-2'de Packages/DesignSystem'e üretilecek. Değişiklik: swiftui-ui + safety-redteam onayı.",
  "version": "0.1.0",
  "color": {
    "victim": {
      "bg": "#000000",
      "surface": "#1F1C18",
      "surfaceAlt": "#14120F",
      "border": "#34302A",
      "text": "#F4EFE6",
      "text2": "#B3ADA2",
      "signal": "#FFB23E",
      "onSignal": "#1A1100",
      "stop": "#FF7A6B"
    },
    "rescuer": {
      "bg": "#0E1114",
      "surface": "#171C21",
      "surfaceAlt": "#20262D",
      "border": "#323A44",
      "text": "#EEF2F5",
      "text2": "#A2ADB9",
      "signal": "#FFB23E",
      "onSignal": "#1A1100",
      "stop": "#FF7A6B"
    },
    "snrRamp": {
      "stops": ["#20262D", "#4A3A16", "#8A631E", "#C9862A", "#FFB23E", "#FFE3AE"],
      "dbAt": [null, 0, 6, 12, 18, 24],
      "note": "İlk durak 'yok' (algılama yok). Segmentli rampa 10 adım: 0…+24 dB doğrusal."
    },
    "state": {
      "confirmingOpacity": 0.55,
      "backgroundCardOpacity": 0.6,
      "nightWatchClockOpacity": 0.3,
      "dashedBorder": { "dash": 6, "gap": 4, "width": 1.5 }
    }
  },
  "type": {
    "family": { "text": "SF Pro (system)", "mono": "SF Mono (system, monospacedDigit)" },
    "victim": {
      "display": { "size": 40, "weight": "bold", "dynamicType": "largeTitle" },
      "title": { "size": 32, "weight": "bold", "dynamicType": "title" },
      "bodyL": { "size": 24, "weight": "regular", "dynamicType": "title3" },
      "body": { "size": 21, "weight": "regular", "dynamicType": "body", "minimum": true },
      "data": { "size": 34, "weight": "semibold", "mono": true }
    },
    "rescuer": {
      "hero": { "size": 72, "weight": "bold", "mono": true, "note": "Sıcak-soğuk SNR sayısı" },
      "title": { "size": 28, "weight": "bold" },
      "cardId": { "size": 24, "weight": "bold", "mono": true },
      "body": { "size": 17, "weight": "regular" },
      "caption": { "size": 15, "weight": "regular" }
    },
    "rules": [
      "Kurban gövde metni ≥ 21 pt. AX5'te taşma yok, satır kırılır, kesilmez.",
      "Sayılar ve ID'ler her zaman monospace. Değer değişince düzen kaymaz."
    ]
  },
  "space": { "xs": 4, "s": 8, "m": 12, "l": 16, "xl": 24, "xxl": 32, "screenInset": 24 },
  "radius": { "chip": 12, "control": 16, "card": 20, "button": 22, "sheet": 28 },
  "hitTarget": { "victimMin": 60, "rescuerMin": 56 },
  "motion": {
    "beaconRing": { "durationMs": 1600, "scaleFrom": 1.0, "scaleTo": 1.25, "trigger": "yalnız ıslık çalarken" },
    "holdToStopMs": 3000,
    "safetyAckDelayMs": 3000,
    "undoWindowMs": 10000,
    "reduceMotion": "Tüm animasyonlar kapalı. Halka statik, ilerleme dolgusu animasyonsuz adımlarla."
  },
  "haptics": {
    "beaconStart": "notification.success",
    "hereTap": "impact.medium",
    "holdToStopProgress": "impact.light her 1 sn",
    "rescuerNewConfirmed": "notification.warning",
    "rescuerConfirming": "yok"
  }
}
